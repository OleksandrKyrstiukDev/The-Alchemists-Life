  id: npc_strength
  displayName: "\u041A\u0440\u0456\u043F\u043A\u0456\u0441\u0442\u044C "
  description: "\u0422\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u0441\u0438\u043B\u044C\u043D\u043E
    \u043F\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u0444\u0456\u0437\u0438\u0447\u043D\u0456
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438.
    \u0414\u043B\u044F \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \u043D\u0435\u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0445
    \u043B\u044E\u0434\u0435\u0439 \u2014 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435."
  instructions: "\u0413\u0456\u0440\u043A\u0456 \u044F\u0433\u043E\u0434\u0438 \u043A\u0438\u0434\u0430\u0442\u0438
    \u0446\u0456\u043B\u0438\u043C\u0438, \u0443 \u0436\u043E\u0434\u043D\u043E\u043C\u0443
    \u0440\u0430\u0437\u0456 \u043D\u0435 \u043F\u043E\u0434\u0440\u0456\u0431\u043D\u044E\u0432\u0430\u0442\u0438
    \u0457\u0445. \u041F\u0435\u0440\u0435\u043C\u0456\u0448\u0443\u0432\u0430\u0442\u0438
    \u0441\u0443\u043C\u0456\u0448 \u0434\u0443\u0436\u0435 \u043D\u0435\u0434\u043E\u0432\u0433\u043E."
