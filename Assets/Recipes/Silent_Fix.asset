  id: silent_fix
  displayName: "\u0422\u0438\u0445\u0430 \u043F\u0440\u0430\u0432\u043A\u0430"
  description: "\u0414\u043B\u044F \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432.
    \u0412\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 \u043A\u0440\u0430\u0439,
    \u0431\u0430\u043B\u0430\u043D\u0441 \u0456 \u0434\u0440\u0456\u0431\u043D\u0456
    \u0434\u0435\u0444\u0435\u043A\u0442\u0438 \u0440\u043E\u0431\u043E\u0447\u043E\u0433\u043E
    \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F."
  instructions: "\u041A\u043E\u0440\u0456\u043D\u044C-\u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u043A
    \u0437\u0430\u043D\u0443\u0440\u0438\u0442\u0438 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
    \u043D\u0430 \u0434\u043D\u043E \u0447\u0430\u0448\u0456. \u0421\u043B\u0456\u0434\u043A\u0443\u0432\u0430\u0442\u0438
    \u0437\u0430 \u0436\u0430\u0440\u043E\u043C: \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u0438
    \u043A\u0438\u043F\u0456\u043D\u043D\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0438."
