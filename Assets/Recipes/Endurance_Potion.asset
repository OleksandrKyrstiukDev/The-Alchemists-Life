  id: endurance_potion
  displayName: "\u0421\u0442\u0456\u0439\u043A\u0456\u0441\u0442\u044C"
  description: "\u0417\u0456\u043B\u043B\u044F \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456.
    \u0414\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u0437\u043D\u0430\u0447\u043D\u043E
    \u0434\u043E\u0432\u0448\u0435 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
    \u0439 \u0447\u0438\u043D\u0438\u0442\u0438 \u043E\u043F\u0456\u0440 \u0432\u0442\u043E\u043C\u0456."
  instructions: "\u0421\u0456\u043B\u044C \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456
    \u0440\u043E\u0437\u0447\u0438\u043D\u0438\u0442\u0438 \u0443 \u0440\u0456\u0434\u0438\u043D\u0456
    \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0434\u043E \u0437\u0430\u043B\u0438\u0448\u043A\u0443.
    \u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0447\u043D\u043E \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E
    \u043A\u0438\u043F'\u044F\u0442\u0438\u0442\u0438 \u0440\u043E\u0437\u0447\u0438\u043D,
    \u0456\u043D\u0430\u043A\u0448\u0435 \u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C
    \u0434\u0456\u0457 \u0437\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u043D\u0430\u043D\u0456\u0432\u0435\u0446\u044C."
