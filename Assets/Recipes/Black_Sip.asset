    \u0456 \u0442\u0435\u043C\u043D\u0438\u0445 \u0446\u0456\u043B\u0435\u0439."
  instructions: "\u0427\u043E\u0440\u043D\u0443 \u043A\u0440\u0430\u043F\u043B\u044E
