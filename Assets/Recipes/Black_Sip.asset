  displayName: "\u0427\u043E\u0440\u043D\u0438\u0439 \u043A\u043E\u0432\u0442\u043E\u043A"
  description: "\u0421\u0438\u043B\u044C\u043D\u0430 \u043F\u0440\u044F\u043C\u043E\u043B\u0456\u043D\u0456\u0439\u043D\u0430
