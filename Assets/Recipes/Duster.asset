  id: dust_settler
  displayName: "\u041F\u0438\u043B\u043E\u0437\u0433\u0456\u043D"
  description: "\u0421\u0443\u043C\u0456\u0448 \u0434\u043B\u044F \u043E\u0441\u0456\u0434\u0430\u043D\u043D\u044F
    \u043F\u0438\u043B\u0443 \u0439 \u0440\u043E\u0437\u043F\u0443\u0441\u043A\u0430\u043D\u043D\u044F
    \u043F\u0430\u0432\u0443\u0442\u0438\u043D\u043D\u044F \u0432 \u0437\u0430\u043A\u0440\u0438\u0442\u043E\u043C\u0443
    \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456. \r\n\u041D\u0435 \u043F\u0440\u0438\u0431\u0438\u0440\u0430\u0454
    \u0431\u0440\u0443\u0434, \u043B\u0438\u0448\u0435 \u0437\u043C\u0443\u0448\u0443\u0454
    \u0439\u043E\u0433\u043E \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456."
  instructions: "\"\u0412\u043B\u0438\u0442\u0438 \u0441\u0442\u043E\u044F\u043B\u0443
    \u0432\u043E\u0434\u0443, \u043D\u0435 \u043F\u0456\u0434\u0456\u0439\u043C\u0430\u044E\u0447\u0438
    \u043E\u0441\u0430\u0434\u0443.\\n\r\n\u0414\u043E\u0434\u0430\u0442\u0438 \u0441\u0443\u0448\u0435\u043D\u0438\u0439
    \u043C\u043E\u0445, \u0440\u043E\u0437\u0442\u0435\u0440\u0442\u0438 \u043C\u0456\u0436
    \u043F\u0430\u043B\u044C\u0446\u044F\u043C\u0438.\\n\r\n\u0414\u0430\u043B\u0456
    \u0437\u0433\u0430\u0434\u0443\u0454\u0442\u044C\u0441\u044F \u043F\u043E\u043C\u0456\u0448\u0443\u0432\u0430\u043D\u043D\u044F,
    \u0430\u043B\u0435 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0430 \u043E\u0431\u0456\u0440\u0432\u0430\u043D\u0430\u2026\""
