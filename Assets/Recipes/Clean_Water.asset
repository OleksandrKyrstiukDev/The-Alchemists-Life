  id: clean_water
  displayName: "\u0427\u0438\u0441\u0442\u0430 \u0432\u043E\u0434\u0430"
  description: "\u0410\u043B\u0445\u0456\u043C\u0456\u0447\u043D\u043E \u043E\u0447\u0438\u0449\u0435\u043D\u0430
    \u0432\u043E\u0434\u0430 \u0434\u043B\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
    \u043B\u044E\u0434\u044C\u043C\u0438 \u0442\u0430 NPC. \r\n\u041D\u0435 \u043B\u0456\u043A\u0443\u0454,
    \u0430\u043B\u0435 \u0443\u0441\u0443\u0432\u0430\u0454 \u0448\u043A\u0456\u0434\u043B\u0438\u0432\u0456
    \u0434\u043E\u043C\u0456\u0448\u043A\u0438 \u0442\u0430 \u0442\u043E\u043A\u0441\u0438\u043D\u0438.
    \r\n\u0427\u0443\u0442\u043B\u0438\u0432\u0430 \u0434\u043E \u043F\u0435\u0440\u0435\u0433\u0440\u0456\u0432\u0443
    \u0442\u0430 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u0434\u0456\u0439."
  instructions: "\"\u0412\u043B\u0438\u0442\u0438 \u0441\u0442\u043E\u044F\u043B\u0443
    \u0432\u043E\u0434\u0443, \u043D\u0435 \u0437\u0434\u0456\u0439\u043C\u0430\u044E\u0447\u0438
    \u043E\u0441\u0430\u0434\u0443.\\n\r\n\u0413\u0456\u0440\u043A\u0443 \u0446\u0432\u0456\u043B\u044C
    \u0432\u0432\u043E\u0434\u0438\u0442\u0438 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E,
    \u0431\u0435\u0437 \u0440\u0456\u0437\u043A\u043E\u0433\u043E \u043D\u0430\u0433\u0440\u0456\u0432\u0443.\\n\r\n\u0414\u043E\u0434\u0430\u0442\u0438
    \u0441\u0443\u0448\u0435\u043D\u0438\u0439 \u043C\u043E\u0445 \u0434\u043B\u044F
    \u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u0457.\\n\r\n\u041D\u0435
    \u043F\u0435\u0440\u0435\u0433\u0440\u0456\u0432\u0430\u0442\u0438. \u041E\u0441\u0430\u0434
    \u043D\u0430 \u0434\u043D\u0456 \u2014 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0438\u0439
    \u0441\u0438\u0433\u043D\u0430\u043B.\""
