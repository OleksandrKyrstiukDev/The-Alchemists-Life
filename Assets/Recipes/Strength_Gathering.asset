  id: strength_gathering
  displayName: "\u0417\u0431\u0456\u0440 \u0441\u0438\u043B"
  description: "\u0422\u043E\u043D\u0456\u0437\u0443\u044E\u0447\u0438\u0439 \u0437\u0430\u0441\u0456\u0431.
    \u041F\u043E\u0432\u0435\u0440\u0442\u0430\u0454 \u0435\u043D\u0435\u0440\u0433\u0456\u044E
    \u0432\u0442\u043E\u043C\u043B\u0435\u043D\u0438\u043C  \u0431\u0435\u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445
    \u0440\u0456\u0437\u043A\u0438\u0445 \u043F\u043E\u0431\u0456\u0447\u043D\u0438\u0445
    \u0435\u0444\u0435\u043A\u0442\u0456\u0432."
  instructions: "\u0421\u0442\u0440\u043E\u0433\u043E \u0441\u0442\u0435\u0436\u0438\u0442\u0438
    \u0437\u0430 \u0442\u0430\u0439\u043C\u0435\u0440\u043E\u043C \u0432\u0430\u0440\u043A\u0438,
    \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0438\u0449\u0438\u0442\u0438 \u043B\u0456\u043C\u0456\u0442
    \u0447\u0430\u0441\u0443 \u043D\u0430\u0441\u0442\u043E\u044E \u0442\u0440\u0430\u0432,
    \u0456\u043D\u0430\u043A\u0448\u0435 \u0441\u0443\u043C\u0456\u0448 \u043F\u0435\u0440\u0435\u043A\u0438\u0441\u043D\u0435\u0442."
