  id: open_heart
  displayName: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0435 \u0441\u0435\u0440\u0446\u0435"
  description: "\u0421\u043E\u0446\u0456\u0430\u043B\u044C\u043D\u0435 \u0437\u0456\u043B\u043B\u044F
    \u0434\u043B\u044F \u0437\u0456\u0437\u043D\u0430\u043D\u044C. \u0417\u043D\u0456\u043C\u0430\u0454
    \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0439 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0438\u0439
    \u043E\u043F\u0456\u0440 \u0456 \u0441\u0442\u0440\u0430\u0445, \u0430\u043B\u0435
    \u043D\u0435 \u043F\u0440\u0438\u043C\u0443\u0448\u0443\u0454 \u0434\u0456\u044F\u0442\u0438
    \u043F\u0440\u043E\u0442\u0438 \u0432\u043E\u043B\u0456."
  instructions: "\u0422\u0435\u043F\u043B\u0438\u0439 \u043F\u0438\u043B\u043E\u043A
    \u0434\u043E\u0434\u0430\u0442\u0438 \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E.
    \u0410\u043B\u0445\u0456\u043C\u0456\u043A\u0443 \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E
    \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044C \u0443 \u043A\u043E\u0442\u0435\u043B
    \u043D\u0430 \u0431\u043B\u0438\u0441\u043A\u0443\u0447\u0443 \u0440\u0456\u0434\u0438\u043D\u0443
    \u043D\u0430\u0434\u0442\u043E \u0434\u043E\u0432\u0433\u043E \u043F\u0456\u0434
    \u0447\u0430\u0441 \u0432\u0430\u0440\u0438\u0432\u0430."
