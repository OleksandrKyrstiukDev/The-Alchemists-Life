  id: crack_collector
  displayName: "\u0422\u0440\u0456\u0449\u0438\u043D\u043E\u0437\u0431\u0456\u0440"
  description: "\u0421\u0443\u043C\u0456\u0448 \u0434\u043B\u044F \u0441\u0442\u0456\u043D
    \u0456 \u043F\u0456\u0434\u043B\u043E\u0433\u0438. \u0417\u0431\u0438\u0440\u0430\u0454
    \u0434\u0440\u0456\u0431\u043D\u0456 \u0442\u0440\u0456\u0449\u0438\u043D\u0438,
    \u0430\u043B\u0435 \u043D\u0435 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
    \u0444\u043E\u0440\u043C\u0443 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E."
  instructions: "\u041A\u0430\u043C'\u044F\u043D\u0438\u0439 \u043F\u0438\u043B \u0432\u0441\u0438\u043F\u0430\u0442\u0438
    \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u0456 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E.
    \u041D\u0435 \u043F\u0435\u0440\u0435\u043C\u0456\u0448\u0443\u0432\u0430\u0442\u0438
    \u043D\u0430\u0434\u0442\u043E \u0434\u043E\u0432\u0433\u043E, \u0449\u043E\u0431
    \u0441\u0443\u043C\u0456\u0448 \u043D\u0435 \u0437\u0430\u0442\u0432\u0435\u0440\u0434\u0456\u043B\u0430
    \u0437\u0430\u0432\u0447\u0430\u0441\u043D\u043E."
