  id: 'mask '
  displayName: "\u041C\u0430\u0441\u043A\u0430"
  description: "\u041F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0437\u043C\u0456\u043D\u044E\u0454
    \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u0439 \u0432\u0438\u0433\u043B\u044F\u0434
    \u0442\u0430 \u043E\u0431\u043B\u0438\u0447\u0447\u044F \u0456\u0441\u0442\u043E\u0442\u0438,
    \u0449\u043E \u043F\u0440\u0438\u0439\u043D\u044F\u043B\u0430 \u0437\u0456\u043B\u043B\u044F."
  instructions: "\u041A\u043E\u0440\u0456\u043D\u044C-\u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u043A
    \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0434\u0440\u0456\u0431\u043D\u0438\u0442\u0438
    \u043F\u0435\u0440\u0435\u0434 \u043A\u0438\u0434\u0430\u043D\u043D\u044F\u043C.
    \u0423 \u043F\u0440\u043E\u0446\u0435\u0441\u0456 \u0440\u0435\u0430\u043A\u0446\u0456\u0457
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0447\u043D\u043E \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E
    \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044C \u0443 \u0434\u0437\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u0443
    \u0440\u0456\u0434\u0438\u043D\u0443 \u043A\u043E\u0442\u043B\u0430."
