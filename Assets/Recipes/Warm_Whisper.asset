  id: warm_whisper
  displayName: "\u0422\u0435\u043F\u043B\u0438\u0439 \u0448\u0435\u043F\u0456\u0442"
  description: "\u0410\u043B\u0445\u0456\u043C\u0456\u0447\u043D\u0430 \u0441\u0443\u043C\u0456\u0448
    \u0434\u043B\u044F \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438 \u043C\u02BC\u044F\u043A\u043E\u0433\u043E
    \u0442\u0435\u043F\u043B\u0430 \u0432 \u043A\u0430\u043C\u0456\u043D\u0430\u0445
    \u0456 \u043F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u044F\u0445. \r\n\u041D\u0435
    \u0441\u0442\u0432\u043E\u0440\u044E\u0454 \u043F\u043E\u043B\u0443\u043C\u02BC\u044F,
    \u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0436\u0430\u0440. \u0427\u0443\u0442\u043B\u0438\u0432\u0430
    \u0434\u043E \u043F\u0435\u0440\u0435\u0433\u0440\u0456\u0432\u0443 \u0442\u0430
    \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u0434\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F
    \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0456\u0432."
  instructions: "\"\u0412\u043B\u0438\u0442\u0438 \u0441\u0442\u043E\u044F\u043B\u0443
    \u0432\u043E\u0434\u0443 \u0442\u0430 \u043F\u043E\u0447\u0430\u0442\u0438 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439
    \u043D\u0430\u0433\u0440\u0456\u0432.\\n\r\n\u041D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u0438
    \u0434\u043E \u043A\u0438\u043F\u0456\u043D\u043D\u044F.\\n\r\n\u041F\u043E\u043F\u0456\u043B
    \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u0430\u043C\u0456\u043D\u0430
    \u0434\u043E\u0434\u0430\u0442\u0438 \u043B\u0438\u0448\u0435 \u043F\u0456\u0441\u043B\u044F
    \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0456\u0432\u0443.\\n\r\n\u0421\u0443\u0448\u0435\u043D\u0438\u0439
    \u043C\u043E\u0445 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
    \u0434\u043B\u044F \u0444\u0456\u043A\u0441\u0430\u0446\u0456\u0457 \u0442\u0435\u043F\u043B\u0430.\""
