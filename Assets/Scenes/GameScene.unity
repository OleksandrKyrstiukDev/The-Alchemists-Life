--- !u!114 &1193217939
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1193217935}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8fa22437c0941d84c9f6f72c59470cab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Feedback
  feedbackTexts:
  - type: 0
    mild:
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0442\u0440\u043E\u0445\u0438
      \u043F\u043E\u0441\u043F\u0456\u0448\u0438\u043B\u0430 \u043F\u0440\u0438\u0431\u0440\u0430\u0442\u0438
      \u043A\u043E\u0442\u0435\u043B \u0437 \u0432\u043E\u0433\u043D\u044E."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u043F\u043E\u0447\u0430\u043B\u0430\u0441\u044F,
      \u0430\u043B\u0435 \u0442\u0430\u043A \u0456 \u043D\u0435 \u0440\u043E\u0437\u043A\u0440\u0438\u043B\u0430\u0441\u044F
      \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E."
    - "\u0429\u0435 \u0442\u0440\u043E\u0445\u0438 \u0442\u0435\u043F\u043B\u0430
      \u0456 \u0431\u0443\u043B\u043E \u0431 \u0437\u043D\u0430\u0447\u043D\u043E
      \u043A\u0440\u0430\u0449\u0435."
    - "\u0421\u0443\u043C\u0456\u0448 \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434\u0442\u043E \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E
      \u0434\u043B\u044F \u0433\u043E\u0442\u043E\u0432\u043E\u0433\u043E \u0437\u0456\u043B\u043B\u044F."
    - "\u041D\u0430\u0447\u0435 \u0432\u0441\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
      \u0430\u043B\u0435 \u0447\u043E\u0433\u043E\u0441\u044C \u0431\u0440\u0430\u043A\u0443\u0454."
    - "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u043D\u0435\u0434\u043E\u043E\u0446\u0456\u043D\u0438\u043B\u0430
      \u0447\u0430\u0441 \u043D\u0430\u0433\u0440\u0456\u0432\u0430\u043D\u043D\u044F."
    - "\u0417\u0430\u043F\u0430\u0445 \u0454, \u043A\u043E\u043B\u0456\u0440 \u0454,
      \u0430 \u043E\u0442 \u0441\u0438\u043B\u0438 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435\u043C\u0430\u0454."
    - "\u0421\u0445\u043E\u0436\u0435, \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u0449\u0435 \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0438 \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0442\u0438\u0441\u044F."
    - "\u0412\u0438\u0433\u043B\u044F\u0434\u0430\u0454 \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u043C."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0434\u0430\u043C \u0440\u0435\u0430\u043A\u0446\u0456\u0457 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0447\u0430\u0441\u0443."
    medium:
    - "\u042F \u044F\u0432\u043D\u043E \u043D\u0435 \u0434\u0430\u043B\u0430 \u0441\u0443\u043C\u0456\u0448\u0456
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0442\u0435\u043F\u043B\u0430"
    - "\u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432
      \u0442\u0430\u043A \u0456 \u043D\u0435 \u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u0438\u0441\u044F."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0437\u0443\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F
      \u0434\u0435\u0441\u044C \u043F\u043E\u0441\u0435\u0440\u0435\u0434 \u0434\u043E\u0440\u043E\u0433\u0438."
    - "\u041A\u043D\u0438\u0433\u0430 \u0431 \u043D\u0430\u0437\u0432\u0430\u043B\u0430
      \u0446\u0435 \u0447\u0435\u0440\u043D\u0435\u0442\u043A\u043E\u044E \u0437\u0456\u043B\u043B\u044F."
    - "\u0412\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B,
      \u0430\u043B\u0435 \u043D\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442."
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0449\u0435 \u0447\u0435\u043A\u0430\u0454
      \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0443."
    - "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u043E\u044E."
    - "\u041D\u0430\u0434\u0442\u043E \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E.
      \u0410\u043B\u0445\u0456\u043C\u0456\u044F \u0442\u0430\u043A\u043E\u0433\u043E
      \u043D\u0435 \u043B\u044E\u0431\u0438\u0442\u044C."
    - "\u041A\u043E\u0442\u0435\u043B \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u0439,
      \u0430 \u0437\u0456\u043B\u043B\u044F \u0449\u0435 \u043D\u0456."
    - "\u041C\u0430\u0431\u0443\u0442\u044C, \u044F \u0437\u0430\u0431\u0440\u0430\u0432
      \u0439\u043E\u0433\u043E \u043D\u0430 \u043F\u0456\u0432\u043A\u0440\u043E\u043A\u0443
      \u0440\u0430\u043D\u0456\u0448\u0435."
    severe:
    - "\u0426\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u0441\u0445\u043E\u0436\u0435
      \u043D\u0430 \u0442\u0435\u043F\u043B\u0438\u0439 \u043D\u0430\u0441\u0442\u0456\u0439,
      \u043D\u0456\u0436 \u043D\u0430 \u0437\u0456\u043B\u043B\u044F."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u0432\u0456\u0434\u0431\u0443\u043B\u0430\u0441\u044F."
    - "\u042F \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u043B\u0430 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u0437\u0430\u0440\u0430\u0434\u0438 \u043A\u043E\u043B\u044C\u043E\u0440\u043E\u0432\u043E\u0457
      \u0432\u043E\u0434\u0438."
    - "\u0421\u0443\u043C\u0456\u0448 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438."
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0456\u0434\u0456\u0433\u0440\u0456\u0432 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438."
    - "\u0412\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
      \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0438\u043C\u0438 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432."
    - "\u041D\u0430\u0432\u0456\u0442\u044C \u043A\u043D\u0438\u0433\u0430 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u043B\u0430
      \u0431 \u0440\u043E\u0437\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043E\u044E."
    - "\u0412\u0430\u0436\u043A\u043E \u0437\u0456\u043F\u0441\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0433\u0440\u0456\u0432\u0430\u043D\u043D\u044F \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0441\u0438\u043B\u044C\u043D\u043E, \u0430\u043B\u0435 \u044F \u0432\u043F\u043E\u0440\u0430\u043B\u0430\u0441\u044C."
    - "\u042F\u043A\u0449\u043E \u0446\u0435 \u0433\u043E\u0442\u043E\u0432\u0435
      \u0437\u0456\u043B\u043B\u044F, \u0442\u043E \u044F \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0430
      \u0430\u043B\u0445\u0456\u043C\u0456\u043A\u0456\u0432."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u043D\u0435 \u043F\u043E\u0447\u0430\u043B\u0430\u0441\u044F.
      \u0412\u043E\u043D\u0430 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435
      \u0437\u0430\u043F\u0456\u0437\u043D\u0438\u043B\u0430\u0441\u044F."
  - type: 1
    mild:
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0442\u0440\u043E\u0445\u0438
      \u0437\u0430\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044F \u0432\u043E\u0433\u043D\u0435\u043C."
    - "\u041F\u043E\u043B\u0443\u043C'\u044F \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u043E \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u043E."
    - "\u0421\u0443\u043C\u0456\u0448 \u0441\u0442\u0430\u043B\u0430 \u0440\u0456\u0437\u043A\u0456\u0448\u043E\u044E,
      \u043D\u0456\u0436 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E."
    - "\u0414\u0435\u044F\u043A\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C \u043D\u0435\u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E."
    - "\u0422\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u0440\u0430\u043D\u0456\u0448\u0435
      \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u0438 \u0432\u043E\u0433\u043E\u043D\u044C."
    - "\u0417\u0456\u043B\u043B\u044F \u0449\u0435 \u0436\u0438\u0432\u0435, \u0430\u043B\u0435
      \u0432\u0436\u0435 \u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0435."
    - "\u041A\u043E\u0442\u0435\u043B \u043D\u0430\u0442\u044F\u043A\u0430\u0432
      \u043C\u0435\u043D\u0456 \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F.
      \u042F \u0439\u043E\u0433\u043E \u043F\u0440\u043E\u0456\u0433\u043D\u043E\u0440\u0443\u0432\u0430\u0432."
    - "\u0413\u0430\u0440\u044F\u0447\u0435. \u0422\u0440\u043E\u0445\u0438 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0433\u0430\u0440\u044F\u0447\u0435."
    - "\u0417\u0430\u043F\u0430\u0445 \u0433\u0430\u0440\u0443 \u043C\u0435\u043D\u0435
      \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0443\u0454."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0434\u0430\u043C \u0441\u0443\u043C\u0456\u0448\u0456 \u043C\u0435\u043D\u0448\u0435
      \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043D\u044C."
    medium:
    - "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0430 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043F\u043E\u0432\u043E\u0434\u0436\u0435\u043D\u043D\u044F."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0441\u0442\u0430\u043B\u0430
      \u043D\u0430\u0434\u0442\u043E \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u043E\u044E."
    - "\u042F \u043F\u043E\u0447\u0430\u043B\u0430 \u0432\u0430\u0440\u0438\u0442\u0438
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u0437\u0456\u043B\u043B\u044F."
    - "\u041A\u043E\u043B\u0456\u0440 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u043F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u043E \u0442\u0435\u043C\u043D\u0438\u043C."
    - "\u0422\u0443\u0442 \u044F\u0432\u043D\u043E \u0431\u0443\u043B\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u0432\u043E\u0433\u043D\u044E, \u043D\u0456\u0436 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E."
    - "\u0421\u0443\u043C\u0456\u0448 \u043F\u0440\u0430\u0446\u044E\u0454, \u0430\u043B\u0435
      \u0441\u0435\u0440\u0434\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u043C\u0435\u043D\u0435."
    - "\u041A\u0456\u043B\u044C\u043A\u0430 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0433\u043E\u0440\u0456\u043B\u0438."
    - "\u041C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u0440\u0456\u0434\u0448\u0435
      \u0431\u043E\u0440\u043E\u0442\u0438\u0441\u044F \u0437 \u0445\u043E\u043B\u043E\u0434\u043E\u043C
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u043E\u043B\u0443\u043C'\u044F."
    - "\u041A\u043E\u0442\u0435\u043B \u043F\u0435\u0440\u0435\u043C\u0456\u0433
      \u0437\u0456\u043B\u043B\u044F."
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0442\u0440\u043E\u0445\u0438
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u0432\u0441\u044F."
    severe:
    - "\u0414\u043E\u0431\u0440\u0435, \u0449\u043E \u0446\u0435 \u043D\u0435 \u0432\u0438\u0431\u0443\u0445\u043D\u0443\u043B\u043E."
    - "\u042F \u043C\u0430\u0439\u0436\u0435 \u0441\u043F\u0430\u043B\u0438\u043B\u0430
      \u0432\u0441\u044E \u0444\u043E\u0440\u043C\u0443\u043B\u0443."
    - "\u042F\u043A\u0449\u043E \u0446\u0435 \u0456 \u0437\u0456\u043B\u043B\u044F,
      \u0442\u043E \u0434\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435."
    - "\u041F\u043E\u043B\u0443\u043C'\u044F \u0437\u043D\u0438\u0449\u0438\u043B\u043E
      \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436 \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u043E."
    - "\u0412\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456 \u0440\u043E\u0437\u0441\u0438\u043F\u0430\u043B\u0438\u0441\u044F
      \u0440\u0430\u0437\u043E\u043C \u0456\u0437 \u0431\u0430\u043B\u0430\u043D\u0441\u043E\u043C."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0432\u0430\u0440\u0442\u043E \u043D\u0435 \u043F\u0430\u043B\u0438\u0442\u0438
      \u0440\u0435\u0446\u0435\u043F\u0442 \u0436\u0438\u0432\u0446\u0435\u043C."
    - "\u0421\u0443\u043C\u0456\u0448 \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0430
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0454 \u043A\u0430\u0442\u0443\u0432\u0430\u043D\u043D\u044F."
    - "\u041C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435
      \u0437\u0456\u043B\u043B\u044F, \u0430 \u043D\u0435 \u043A\u0440\u0435\u043C\u0430\u0442\u043E\u0440\u0456\u0439
      \u0434\u043B\u044F \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0456\u0432."
    - "\u041A\u043E\u043B\u0456\u0440 \u043D\u0430\u0442\u044F\u043A\u0430\u0454,
      \u0449\u043E \u044F \u043F\u0440\u0438\u043F\u0443\u0441\u0442\u0438\u0432\u0441\u044F
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0457 \u043F\u043E\u043C\u0438\u043B\u043A\u0438."
    - "\u0410\u043B\u0445\u0456\u043C\u0456\u044F \u0431\u0443\u043B\u0430 \u043F\u0440\u043E\u0442\u0438
      \u0446\u044C\u043E\u0433\u043E \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u0437
      \u0441\u0430\u043C\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443."
  - type: 2
    mild:
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0442\u0440\u043E\u0445\u0438 \u043D\u0435\u0440\u0456\u0432\u043D\u043E\u043C\u0456\u0440\u043D\u043E\u044E."
    - "\u041C\u0430\u0431\u0443\u0442\u044C, \u0432\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E
      \u0449\u0435 \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432
      \u043F\u043E\u043C\u0456\u0448\u0430\u0442\u0438."
    - "\u041D\u0435 \u0432\u0441\u0456 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438
      \u0432\u0441\u0442\u0438\u0433\u043B\u0438 \u0437\u043C\u0456\u0448\u0430\u0442\u0438\u0441\u044F."
    - "\u0412\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u043B\u0435\u0433\u043A\u0430
      \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u0456\u0434\u043D\u0456\u0441\u0442\u044C."
    - "\u0417\u0456\u043B\u043B\u044F \u043F\u0440\u0430\u0446\u044E\u0454, \u0430\u043B\u0435
      \u043D\u0435 \u0434\u0443\u0436\u0435 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u043E."
    - "\u0414\u0435\u044F\u043A\u0456 \u0447\u0430\u0441\u0442\u0438\u043D\u0438
      \u0441\u0443\u043C\u0456\u0448\u0456 \u0436\u0438\u0432\u0443\u0442\u044C \u043E\u043A\u0440\u0435\u043C\u0438\u043C
      \u0436\u0438\u0442\u0442\u044F\u043C."
    - "\u0429\u0435 \u0442\u0440\u043E\u0445\u0438 \u0442\u0435\u0440\u043F\u0456\u043D\u043D\u044F
      \u0431\u0443\u043B\u043E \u0431 \u043D\u0435 \u0437\u0430\u0439\u0432\u0438\u043C."
    - "\u0406\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438 \u0437\u043D\u0430\u0439\u043E\u043C\u0456,
      \u0430\u043B\u0435 \u0449\u0435 \u043D\u0435 \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044F."
    - "\u041D\u0430\u0447\u0435\u0431\u0442\u043E \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u044F,
      \u0430\u043B\u0435 \u0432\u043E\u043D\u0430 \u043F\u043E\u043C\u0456\u0442\u043D\u0430."
    - "\u041B\u043E\u0436\u043A\u0430 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E."
    medium:
    - "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432
      \u0442\u0430\u043A \u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u043D\u044C."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0432\u0456\u0434\u0431\u0443\u043B\u0430\u0441\u044F
      \u043B\u0438\u0448\u0435 \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E."
    - "\u0421\u0443\u043C\u0456\u0448 \u043D\u0435 \u0441\u0442\u0430\u043B\u0430
      \u0454\u0434\u0438\u043D\u0438\u043C \u0446\u0456\u043B\u0438\u043C."
    - "\u042F \u043D\u0430\u0434\u0442\u043E \u0440\u0430\u043D\u043E \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430,
      \u0449\u043E \u0446\u044C\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E."
    - "\u0406\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0443\u044E\u0442\u044C
      \u043C\u0456\u0436 \u0441\u043E\u0431\u043E\u044E."
    - "\u0412\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456 \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B\u0438\u043B\u0438\u0441\u044F
      \u043D\u0435\u0440\u0456\u0432\u043D\u043E\u043C\u0456\u0440\u043D\u043E."
    - "\u0412\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u043D\u0435\u0441\u0442\u0430\u0447\u0430
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0437 \u0441\u0443\u043C\u0456\u0448\u0448\u044E."
    - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043C\u0456\u0433
      \u0431\u0443\u0442\u0438 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043A\u0440\u0430\u0449\u0438\u043C."
    - "\u041A\u043E\u0442\u0435\u043B \u043F\u0440\u043E\u0441\u0438\u0432 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0443\u0432\u0430\u0433\u0438."
    - "\u041C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E
      \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0442\u0435\u0440\u043F\u0456\u043D\u043D\u044F."
    severe:
    - "\u0426\u0435 \u043D\u0430\u0431\u0456\u0440 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0456\u0432,
      \u0430 \u043D\u0435 \u0437\u0456\u043B\u043B\u044F."
    - "\u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 \u0442\u0430\u043A
      \u0456 \u043D\u0435 \u0441\u0442\u0430\u043B\u0438 \u043E\u0434\u043D\u0456\u0454\u044E
      \u0441\u0443\u043C\u0456\u0448\u0448\u044E."
    - "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F \u043E\u043A\u0440\u0435\u043C\u043E."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0440\u043E\u0437\u043F\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F."
    - "\u042F \u043D\u0435\u0434\u043E\u043E\u0446\u0456\u043D\u0438\u0432 \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u043C\u0456\u0448\u0443\u0432\u0430\u043D\u043D\u044F."
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0457\u0457 \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438
      \u043F\u043E\u0441\u0435\u0440\u0435\u0434 \u043F\u0440\u043E\u0446\u0435\u0441\u0443."
    - "\u041D\u0430\u0432\u0456\u0442\u044C \u0432\u043E\u0434\u0430 \u043F\u0435\u0440\u0435\u043C\u0456\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043A\u0440\u0430\u0449\u0435."
    - "\u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 \u0434\u043E\u0441\u0456
      \u0441\u043F\u0435\u0440\u0435\u0447\u0430\u044E\u0442\u044C\u0441\u044F \u043C\u0456\u0436
      \u0441\u043E\u0431\u043E\u044E."
    - "\u042F \u0434\u0430\u0440\u043C\u0430 \u0434\u0456\u0441\u0442\u0430\u0432\u0430\u043B\u0430
      \u043B\u043E\u0436\u043A\u0443, \u044F\u043A\u0449\u043E \u0432\u0436\u0435
      \u043D\u0430 \u0442\u0435 \u043F\u0456\u0448\u043B\u043E."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0432\u0430\u0440\u0442\u043E \u0445\u043E\u0447 \u0442\u0440\u043E\u0445\u0438
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0430\u043C."
  - type: 3
    mild:
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0442\u0440\u043E\u0445\u0438
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044F."
    - "\u041D\u0435 \u043A\u043E\u0436\u043D\u0443 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438
      \u043B\u043E\u0436\u043A\u043E\u044E."
    - "\u0421\u0443\u043C\u0456\u0448 \u0441\u0442\u0430\u043B\u0430 \u043D\u0430\u0434\u0442\u043E
      \u043E\u0434\u043D\u043E\u0440\u0456\u0434\u043D\u043E\u044E."
    - "\u042F \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0430
      \u043F\u043E\u043C\u0456\u0448\u0443\u0432\u0430\u0442\u0438 \u0431\u0435\u0437
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0457 \u043F\u0440\u0438\u0447\u0438\u043D\u0438."
    - "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u043F\u043E\u0447\u0430\u043B\u0430 \u0441\u043B\u0430\u0431\u0448\u0430\u0442\u0438."
    - "\u0422\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F
      \u0440\u0430\u043D\u0456\u0448\u0435."
    - "\u0417\u0430\u0439\u0432\u0430 \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u0456\u0441\u0442\u044C
      \u0442\u0435\u0436 \u0431\u0443\u0432\u0430\u0454 \u0448\u043A\u0456\u0434\u043B\u0438\u0432\u043E\u044E."
    - "\u041C\u0430\u0431\u0443\u0442\u044C, \u044F \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0437\u0430\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u043C."
    - "\u0421\u0443\u043C\u0456\u0448 \u0443\u0436\u0435 \u0431\u0443\u043B\u0430
      \u0433\u043E\u0442\u043E\u0432\u0430 \u0431\u0435\u0437 \u043C\u043E\u0454\u0457
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438."
    - "\u0406\u043D\u043A\u043E\u043B\u0438 \u0432\u0430\u0440\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438 \u0437\u0456\u043B\u043B\u044F
      \u0443 \u0441\u043F\u043E\u043A\u043E\u0457."
    medium:
    - "\u042F \u043F\u0435\u0440\u0435\u043C\u0456\u0448\u0443\u0432\u0430\u043B\u0430
      \u0434\u043E\u0432\u0448\u0435, \u043D\u0456\u0436 \u0431\u0443\u043B\u043E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E."
    - "\u0414\u0435\u044F\u043A\u0456 \u0435\u0444\u0435\u043A\u0442\u0438 \u043F\u043E\u0447\u0430\u043B\u0438
      \u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430
      \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u0441\u0438\u043B\u0438."
    - "\u041D\u0430\u0434\u043C\u0456\u0440\u043D\u0430 \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u0456\u0441\u0442\u044C
      \u0437\u043D\u043E\u0432\u0443 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438."
    - "\u041A\u0456\u043B\u044C\u043A\u0430 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0441\u0442\u0435\u0440\u043B\u0438\u0441\u044F."
    - "\u0417\u0456\u043B\u043B\u044F \u0432\u0436\u0435 \u043F\u0440\u043E\u0441\u0438\u043B\u043E
      \u043C\u0435\u043D\u0435 \u043F\u0440\u0438\u043F\u0438\u043D\u0438\u0442\u0438."
    - "\u0406\u043D\u043A\u043E\u043B\u0438 \u043C\u0435\u043D\u0448\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454
      \u0431\u0456\u043B\u044C\u0448\u0435."
    - "\u0411\u0430\u043B\u0430\u043D\u0441 \u043F\u043E\u0447\u0430\u0432 \u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0432\u0456\u0434 \u043C\u043E\u0454\u0457 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456."
    - "\u042F \u0432\u0442\u0440\u0443\u0442\u0438\u043B\u0430\u0441\u044F \u0442\u0443\u0434\u0438,
      \u0434\u0435 \u0432\u0441\u0435 \u0432\u0436\u0435 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u043E."
    - "\u0422\u0440\u0435\u0431\u0430 \u0432\u0447\u0438\u0442\u0438\u0441\u044F
      \u0432\u0447\u0430\u0441\u043D\u043E \u0437\u0443\u043F\u0438\u043D\u044F\u0442\u0438\u0441\u044F."
    severe:
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u043F\u0435\u0440\u0435\u043C\u0456\u0448\u0430\u043B\u0430
      \u043D\u0430\u0432\u0456\u0442\u044C \u0442\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456,
      \u044F\u043A\u0456 \u0447\u0456\u043F\u0430\u0442\u0438 \u043D\u0435 \u0432\u0430\u0440\u0442\u043E
      \u0431\u0443\u043B\u043E."
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430
      \u0441\u0432\u0456\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440.
      \u0406, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0441\u0435\u043D\u0441
      \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0442\u0435\u0436."
    - "\u042F \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u0437\u0430\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044F
      \u043B\u043E\u0436\u043A\u043E\u044E, \u0449\u043E \u0437\u0430\u0431\u0443\u043B\u0430
      \u043F\u0440\u043E \u0430\u043B\u0445\u0456\u043C\u0456\u044E."
    - "\u042F \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0430
      \u043C\u0456\u0448\u0430\u0442\u0438 \u043D\u0430\u0432\u0456\u0442\u044C \u0442\u043E\u0434\u0456,
      \u043A\u043E\u043B\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u0438\u0439 \u0433\u043B\u0443\u0437\u0434
      \u0443\u0436\u0435 \u0432\u0438\u0439\u0448\u043E\u0432 \u0456\u0437 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u0457."
    - "\u0412\u0456\u0434 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u043E\u0457
      \u0444\u043E\u0440\u043C\u0443\u043B\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
      \u043B\u0438\u0448\u0435 \u0441\u043F\u043E\u0433\u0430\u0434\u0438 \u0442\u0430
      \u0431\u0443\u043B\u044C\u0431\u0430\u0448\u043A\u0438."
    - "\u041C\u0430\u0431\u0443\u0442\u044C, \u043B\u043E\u0436\u043A\u0430 \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0430
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u043D\u0456\u0436 \u0441\u0430\u043C \u043A\u043E\u0442\u0435\u043B."
    - "\u0421\u0445\u043E\u0436\u0435, \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u044F \u0432\u0456\u0434\u043A\u0440\u0438\u043B\u0430 \u043D\u043E\u0432\u0438\u0439
      \u0441\u043F\u043E\u0441\u0456\u0431 \u0437\u0456\u043F\u0441\u0443\u0432\u0430\u0442\u0438
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442."
    - "\u042F\u043A\u0449\u043E \u0437\u0456\u043B\u043B\u044F \u0439 \u043C\u0430\u043B\u043E
      \u044F\u043A\u0456\u0441\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u0438,
      \u044F \u0432\u0438\u043C\u0456\u0448\u0430\u043B\u0430 \u0457\u0445 \u0443\u0441\u0456
      \u0434\u043E \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E."
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0457\u0457 \u0437\u0431\u0438\u0432\u0430\u043B\u0438
      \u043D\u0430 \u0437\u043C\u0430\u0433\u0430\u043D\u043D\u044F\u0445 \u0456\u0437
      \u0437\u0430\u0432\u0437\u044F\u0442\u0442\u044F."
    - "\u0414\u0435\u044F\u043A\u0456 \u0430\u043B\u0445\u0456\u043C\u0456\u043A\u0438
      \u0448\u0443\u043A\u0430\u044E\u0442\u044C \u0431\u0430\u043B\u0430\u043D\u0441.
      \u042F, \u0441\u0445\u043E\u0436\u0435, \u0448\u0443\u043A\u0430\u043B\u0430
      \u0441\u0432\u0456\u0442\u043E\u0432\u0438\u0439 \u0440\u0435\u043A\u043E\u0440\u0434
      \u0456\u0437 \u043F\u043E\u043C\u0456\u0448\u0443\u0432\u0430\u043D\u043D\u044F."
  - type: 4
    mild:
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0446\u0456 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u043D\u0435 \u0434\u0443\u0436\u0435 \u0434\u043E\u0432\u0456\u0440\u044F\u044E\u0442\u044C
      \u043E\u0434\u0438\u043D \u043E\u0434\u043D\u043E\u043C\u0443."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u043F\u0440\u043E\u0439\u0448\u043B\u0430
      \u0434\u0438\u0432\u043D\u043E, \u0430\u043B\u0435 \u043F\u043E\u043A\u0438
      \u0449\u043E \u043F\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C."
    - "\u0423 \u0441\u0443\u043C\u0456\u0448\u0456 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u043B\u0435\u0433\u043A\u0430 \u043D\u0435\u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C."
    - "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043E\u0434\u0438\u043D \u0456\u0437
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432 \u0442\u0443\u0442
      \u0437\u0430\u0439\u0432\u0438\u0439."
    - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043F\u0440\u0430\u0446\u044E\u0454,
      \u0445\u043E\u0447\u0430 \u0439 \u043D\u0435 \u0442\u0430\u043A \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u043E,
      \u044F\u043A \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F \u0431."
    - "\u0429\u043E\u0441\u044C \u0443 \u0444\u043E\u0440\u043C\u0443\u043B\u0456
      \u043D\u0435 \u0437\u043E\u0432\u0441\u0456\u043C \u0441\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F."
    - "\u0421\u0443\u043C\u0456\u0448 \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0442\u0440\u043E\u0445\u0438 \u043F\u0440\u0438\u043C\u0445\u043B\u0438\u0432\u043E."
    - "\u041D\u0430\u0447\u0435 \u0432\u0441\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
      \u0430\u043B\u0435 \u0454 \u044F\u043A\u0435\u0441\u044C \u0434\u0438\u0432\u043D\u0435
      \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F."
    - "\u0414\u0435\u044F\u043A\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456
      \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C\u0441\u044F."
    - "\u041F\u043E\u043A\u0438 \u0449\u043E \u0446\u0435 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E. \u041F\u043E\u043A\u0438
      \u0449\u043E."
    medium:
    - "\u0406\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438 \u044F\u0432\u043D\u043E
      \u043F\u043E\u0447\u0430\u043B\u0438 \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0443\u0432\u0430\u0442\u0438
      \u043C\u0456\u0436 \u0441\u043E\u0431\u043E\u044E."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u0442\u0440\u0438\u043C\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0447\u0435\u0441\u043D\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0456."
    - "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439
      \u043F\u0440\u0430\u0446\u044E\u0454 \u043E\u0434\u043D\u0430 \u043F\u0440\u043E\u0442\u0438
      \u043E\u0434\u043D\u043E\u0457."
    - "\u042F \u0437\u043C\u0456\u0448\u0430\u043B\u0430 \u0440\u0435\u0447\u0456,
      \u044F\u043A\u0456 \u043D\u0435 \u0434\u0443\u0436\u0435 \u0445\u043E\u0442\u0456\u043B\u0438
      \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0432\u0438\u0439\u0448\u043B\u0430
      \u043D\u0430\u043F\u0440\u043E\u0447\u0443\u0434 \u043D\u0435\u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E\u044E."
    - "\u0421\u0443\u043C\u0456\u0448 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E
      \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u0437\u043C\u0456\u043D\u0438\u0442\u0438
      \u0441\u0432\u043E\u044E \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0443."
    - "\u0414\u0435\u044F\u043A\u0456 \u0435\u0444\u0435\u043A\u0442\u0438 \u0432\u0438\u043D\u0438\u043A\u0430\u044E\u0442\u044C
      \u0456 \u043E\u0434\u0440\u0430\u0437\u0443 \u0437\u043D\u0438\u043A\u0430\u044E\u0442\u044C."
    - "\u0411\u0430\u043B\u0430\u043D\u0441 \u0444\u043E\u0440\u043C\u0443\u043B\u0438
      \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u0438\u0439."
    - "\u0429\u043E\u0441\u044C \u043F\u0456\u0434\u043A\u0430\u0437\u0443\u0454
      \u043C\u0435\u043D\u0456, \u0449\u043E \u0446\u0435 \u043D\u0435 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430
      \u043A\u043E\u043C\u0431\u0456\u043D\u0430\u0446\u0456\u044F."
    - "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043D\u0430\u0441\u0442\u0430\u0432
      \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438
      \u0441\u043A\u043B\u0430\u0434."
    severe:
    - "\u042F \u043C\u0430\u0439\u0436\u0435 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430,
      \u0449\u043E \u0446\u0456 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u044F\u0442\u044C \u043E\u0434\u043D\u0435
      \u043E\u0434\u043D\u043E\u0433\u043E."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0440\u043E\u0437\u0432\u0430\u043B\u044E\u0454\u0442\u044C\u0441\u044F \u043D\u0430
      \u043E\u0447\u0430\u0445."
    - "\u0421\u0443\u043C\u0456\u0448 \u043F\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435\u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0443\u0432\u0430\u043D\u043E
      \u0449\u043E\u0441\u0435\u043A\u0443\u043D\u0434\u0438."
    - "\u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438, \u044F
      \u0432\u0436\u0435 \u0431\u043E\u044E\u0441\u044F \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0442\u0438
      \u043A\u043E\u0440\u043E\u043A."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0432\u0438\u0439\u0448\u043B\u0430
      \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0435\u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u044E,
      \u0449\u043E \u0457\u0457 \u0432\u0430\u0436\u043A\u043E \u043E\u043F\u0438\u0441\u0430\u0442\u0438."
    - "\u0414\u043E\u0431\u0440\u0435, \u0449\u043E \u043A\u043E\u0442\u0435\u043B
      \u043F\u0435\u0440\u0435\u0436\u0438\u0432 \u0446\u0435\u0439 \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442."
    - "\u0417\u0456\u043B\u043B\u044F \u0437\u043C\u0456\u043D\u044E\u0454 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456
      \u0448\u0432\u0438\u0434\u0448\u0435, \u043D\u0456\u0436 \u044F \u0432\u0441\u0442\u0438\u0433\u0430\u044E
      \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438."
    - "\u0421\u0445\u043E\u0436\u0435, \u044F \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E
      \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443."
    - "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0449\u043E \u0446\u0435 \u0442\u0430\u043A\u0435.
      \u0406 \u0446\u0435 \u043C\u0435\u043D\u0435 \u0442\u0443\u0440\u0431\u0443\u0454."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u043A\u0440\u0430\u0449\u0435 \u043D\u0435 \u0437\u043C\u0456\u0448\u0443\u0432\u0430\u0442\u0438
      \u0432\u0441\u0435, \u0449\u043E \u043F\u043E\u0433\u0430\u043D\u043E \u043B\u0435\u0436\u0438\u0442\u044C."
  - type: 5
    mild:
    - "\u0412\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u043B\u0435\u0433\u043A\u0430
      \u0433\u0456\u0440\u043A\u043E\u0442\u0430, \u044F\u043A\u043E\u0457 \u0442\u0443\u0442
      \u0431\u0443\u0442\u0438 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u043E."
    - "\u0421\u0443\u043C\u0456\u0448 \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0430
      \u043D\u0435\u0431\u0430\u0436\u0430\u043D\u0456 \u0434\u043E\u043C\u0456\u0448\u043A\u0438."
    - "\u041A\u043E\u0440\u0438\u0441\u043D\u0438\u0439 \u0435\u0444\u0435\u043A\u0442
      \u0454, \u0430\u043B\u0435 \u043D\u0435 \u0431\u0435\u0437 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0456\u0432."
    - "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u0442\u0440\u043E\u0445\u0438
      \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u0449\u0438\u043B\u0430 \u0437 \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u043C\u0438
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430\u043C\u0438."
    - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0432\u0438\u0439\u0448\u043E\u0432
      \u043D\u0435 \u0442\u0430\u043A\u0438\u043C \u0447\u0438\u0441\u0442\u0438\u043C,
      \u044F\u043A \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F \u0431."
    - "\u042F \u0431 \u043D\u0435 \u0441\u0442\u0430\u043B\u0430 \u043F\u0438\u0442\u0438
      \u0446\u0435 \u0449\u043E\u0434\u043D\u044F."
    - "\u0404 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F, \u0449\u043E \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043C
      \u043F\u043E\u0434\u044F\u043A\u0443\u0454 \u043D\u0435 \u0437\u0430 \u0432\u0441\u0435."
    - "\u041F\u043E\u0431\u0456\u0447\u043D\u0456 \u0435\u0444\u0435\u043A\u0442\u0438
      \u0432\u0436\u0435 \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C \u043F\u0440\u043E\u0433\u043B\u044F\u0434\u0430\u0442\u0438\u0441\u044F."
    - "\u0417\u0456\u043B\u043B\u044F \u043F\u0440\u0430\u0446\u044E\u0454, \u0430\u043B\u0435
      \u0437 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C."
    - "\u0422\u0440\u0435\u0431\u0430 \u0443\u0432\u0430\u0436\u043D\u0456\u0448\u0435
      \u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430 \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0456\u044F\u043C\u0438."
    medium:
    - "\u041F\u043E\u0431\u0456\u0447\u043D\u0456 \u0435\u0444\u0435\u043A\u0442\u0438
      \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u0434\u0442\u043E \u043F\u043E\u043C\u0456\u0442\u043D\u0438\u043C\u0438."
    - "\u0426\u0435 \u043B\u0456\u043A\u0443\u0454 \u043E\u0434\u043D\u0443 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443
      \u0456 \u0441\u0442\u0432\u043E\u0440\u044E\u0454 \u0456\u043D\u0448\u0443."
    - "\u0422\u043E\u043A\u0441\u0438\u0447\u043D\u0456\u0441\u0442\u044C \u043F\u043E\u0447\u0438\u043D\u0430\u0454
      \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u0430\u0442\u0438 \u043A\u043E\u0440\u0438\u0441\u0442\u044C."
    - "\u0417\u0430\u043C\u043E\u0432\u043D\u0438\u043A \u043D\u0430\u0432\u0440\u044F\u0434
      \u0447\u0438 \u0431\u0443\u0434\u0435 \u0443 \u0437\u0430\u0445\u0432\u0430\u0442\u0456."
    - "\u0421\u0443\u043C\u0456\u0448 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u043E\u044E."
    - "\u042F \u044F\u0432\u043D\u043E \u043D\u0435\u0434\u043E\u043E\u0446\u0456\u043D\u0438\u043B\u0430
      \u0441\u0438\u043B\u0443 \u0434\u0435\u044F\u043A\u0438\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432."
    - "\u041E\u0440\u0433\u0430\u043D\u0456\u0437\u043C \u0442\u043E\u0447\u043D\u043E
      \u0432\u0456\u0434\u0447\u0443\u0454 \u0446\u0435 \u0437\u0456\u043B\u043B\u044F."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E\u0433\u043E \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044F."
    - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0454
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u0438\u0442\u0430\u043D\u044C,
      \u043D\u0456\u0436 \u0434\u043E\u0432\u0456\u0440\u0438."
    - "\u0412\u0430\u0440\u0442\u043E \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u0438
      \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0456\u044E \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0445
      \u0440\u0435\u0447\u043E\u0432\u0438\u043D."
    severe:
    - "\u042F \u0431 \u043D\u0435 \u0440\u0438\u0437\u0438\u043A\u043D\u0443\u043B\u0430
      \u0446\u0435 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0443 \u0432\u0438\u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443."
    - "\u041A\u043E\u0440\u0438\u0441\u043D\u0438\u0439 \u0435\u0444\u0435\u043A\u0442
      \u0442\u0443\u0442 \u0443\u0436\u0435 \u043D\u0435 \u0433\u043E\u043B\u043E\u0432\u043D\u0430
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430."
    - "\u0421\u0445\u043E\u0436\u0435, \u044F \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430
      \u043E\u0442\u0440\u0443\u0442\u0443 \u0437 \u0431\u043E\u043D\u0443\u0441\u043D\u0438\u043C\u0438
      \u0444\u0443\u043D\u043A\u0446\u0456\u044F\u043C\u0438."
    - "\u0426\u0435 \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0442\u0435, \u0449\u043E
      \u0445\u043E\u0442\u0456\u0432 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438."
    - "\u0422\u043E\u043A\u0441\u0438\u0447\u043D\u0456\u0441\u0442\u044C \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0432\u0438\u0439\u0448\u043B\u0430 \u0437-\u043F\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E."
    - "\u041C\u0435\u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0443\u0454
      \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u043F\u0430\u0445."
    - "\u0414\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0456\u0432 \u0434\u043B\u044F
      \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u044C \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u043D\u0435 \u0431\u0443\u0434\u0435."
    - "\u0417\u0456\u043B\u043B\u044F \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u043E\u0431\u0440\u0430\u0437\u043B\u0438\u0432\u043E \u0434\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E
      \u0436\u0438\u0432\u043E\u0433\u043E."
    - "\u042F\u043A\u0449\u043E \u0446\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435,
      \u0442\u043E \u0434\u0443\u0436\u0435 \u0441\u0432\u043E\u0454\u0440\u0456\u0434\u043D\u043E."
    - "\u042F \u0431 \u0442\u0440\u0438\u043C\u0430\u043B\u0430 \u0446\u0435 \u043F\u043E\u0434\u0430\u043B\u0456
      \u0432\u0456\u0434 \u043B\u044E\u0434\u0435\u0439."
  - type: 6
    mild:
    - "\u0421\u0445\u043E\u0436\u0435, \u044F \u0442\u0440\u043E\u0445\u0438 \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u043B\u0430."
    - "\u0414\u0435\u044F\u043A\u0456 \u0434\u0435\u0442\u0430\u043B\u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
      \u0431\u0435\u0437 \u0443\u0432\u0430\u0433\u0438."
    - "\u0412\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u0442\u0438
      \u0449\u0435 \u043A\u0456\u043B\u044C\u043A\u0430 \u0445\u0432\u0438\u043B\u0438\u043D."
    - "\u041F\u043E\u0441\u043F\u0456\u0445 \u0437\u0430\u043B\u0438\u0448\u0438\u0432
      \u0441\u0432\u0456\u0439 \u0441\u043B\u0456\u0434."
    - "\u041F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043C\u043E\u0433\u043B\u0430
      \u0431\u0443\u0442\u0438 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u0456\u0448\u043E\u044E."
    - "\u042F \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0448\u0432\u0438\u0434\u043A\u043E
      \u043F\u0435\u0440\u0435\u0439\u0448\u043B\u0430 \u0434\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E
      \u0435\u0442\u0430\u043F\u0443."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u0446\u044C\u043E\u0433\u043E
      \u043D\u0435 \u043E\u0446\u0456\u043D\u0438\u043B\u0430."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438\u043C\u0443 \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u0456\u0448\u0435."
    - "\u041D\u0435 \u0432\u0441\u0456 \u0434\u0440\u0456\u0431\u043D\u0438\u0446\u0456
      \u0431\u0443\u043B\u0438 \u0432\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0456."
    - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043C\u0456\u0433
      \u0431\u0443\u0442\u0438 \u043A\u0440\u0430\u0449\u0438\u043C."
    medium:
    - "\u042F \u044F\u0432\u043D\u043E \u043F\u043E\u0441\u043F\u0456\u0448\u0438\u043B\u0430
      \u0456\u0437 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u044E."
    - "\u0414\u0435\u044F\u043A\u0456 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u043D\u0435 \u0431\u0443\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u0456
      \u0434\u043E \u0440\u043E\u0431\u043E\u0442\u0438."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u043D\u0435\u0434\u043E\u043F\u0440\u0430\u0446\u044C\u043E\u0432\u0430\u043D\u043E\u044E."
    - "\u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u043B\u0435\u043C
      \u043F\u043E\u0447\u0430\u043B\u0430\u0441\u044F \u0449\u0435 \u0434\u043E
      \u043A\u043E\u0442\u043B\u0430."
    - "\u0412\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u043F\u0440\u0438\u0434\u0456\u043B\u0438\u0442\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0443\u0432\u0430\u0433\u0438 \u0434\u0435\u0442\u0430\u043B\u044F\u043C."
    - "\u041F\u043E\u0441\u043F\u0456\u0445 \u0434\u043E\u0440\u043E\u0433\u043E
      \u043E\u0431\u0456\u0439\u0448\u043E\u0432\u0441\u044F \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0443."
    - "\u0420\u0435\u0430\u043A\u0446\u0456\u044F \u0432\u0438\u0439\u0448\u043B\u0430
      \u0433\u0440\u0443\u0431\u043E\u044E."
    - "\u0421\u0445\u043E\u0436\u0435, \u044F \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0445
      \u043A\u0440\u043E\u043A\u0456\u0432."
    - "\u0410\u043B\u0445\u0456\u043C\u0456\u044F \u043D\u0435 \u043B\u044E\u0431\u0438\u0442\u044C
      \u043F\u043E\u0441\u043F\u0456\u0448\u043D\u0438\u0445 \u0440\u0456\u0448\u0435\u043D\u044C."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0442\u0440\u0435\u0431\u0430 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0443\u0432\u0430\u0436\u043D\u0456\u0448\u0435."
    severe:
    - "\u042F \u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044C \u0432 \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442
      \u0431\u0435\u0437 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438."
    - "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043F\u043E\u043C\u0438\u043B\u043E\u043A
      \u0432\u0438\u043D\u0438\u043A\u043B\u0430 \u0449\u0435 \u0434\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u0432\u0430\u0440\u0456\u043D\u043D\u044F."
    - "\u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438, \u044F
      \u0441\u0430\u043C\u0430 \u0432\u0438\u043D\u043D\u0430 \u0443 \u0446\u044C\u043E\u043C\u0443
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0456."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043B\u0430
      \u0432\u0456\u0434 \u043C\u043E\u0454\u0457 \u043D\u0435\u0442\u0435\u0440\u043F\u043B\u044F\u0447\u043E\u0441\u0442\u0456."
    - "\u042F \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u0431\u0456\u043B\u044C\u0448\u0435,
      \u043D\u0456\u0436 \u0437\u0440\u043E\u0431\u0438\u043B\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    - "\u041A\u043D\u0438\u0433\u0430 \u0431 \u0437\u0430\u0440\u0430\u0437 \u0437\u0430\u043A\u0440\u0438\u043B\u0430\u0441\u044F
      \u0432\u0456\u0434 \u0441\u043E\u0440\u043E\u043C\u0443."
    - "\u041F\u043E\u0441\u043F\u0456\u0445 \u0437\u043D\u0438\u0449\u0438\u0432
      \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B \u0446\u0456\u0454\u0457
      \u0441\u0443\u043C\u0456\u0448\u0456."
    - "\u0421\u0445\u043E\u0436\u0435, \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
      \u0456\u043C\u043F\u0440\u043E\u0432\u0456\u0437\u0443\u0432\u0430\u0442\u0438
      \u0442\u0430\u043C, \u0434\u0435 \u043D\u0435 \u0432\u0430\u0440\u0442\u043E."
    - "\u041D\u0435 \u043D\u0430\u0439\u0440\u043E\u0437\u0443\u043C\u043D\u0456\u0448\u0435
      \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u0437 \u043C\u043E\u0433\u043E
      \u0431\u043E\u043A\u0443."
    - "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0443\u0440\u043E\u043A \u043F\u0440\u043E
      \u0442\u0435, \u0447\u043E\u043C\u0443 \u0430\u043B\u0445\u0456\u043C\u0456\u043A\u0438
      \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E."
  - type: 7
    mild:
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0442\u0440\u043E\u0445\u0438
      \u043F\u0435\u0440\u0435\u0442\u0440\u0438\u043C\u0430\u043B\u0430 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438."
    - "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u0441\u0432\u0456\u0436\u043E\u0441\u0442\u0456
      \u0432\u0436\u0435 \u0432\u0442\u0440\u0430\u0447\u0435\u043D\u0430."
    - "\u0426\u0435 \u0449\u0435 \u043F\u0440\u0430\u0446\u044E\u0454, \u0430\u043B\u0435
      \u0432\u0436\u0435 \u043D\u0435 \u0456\u0434\u0435\u0430\u043B\u044C\u043D\u043E."
    - "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u0430\u0440\u0442\u043E
      \u0431\u0443\u043B\u043E \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F
      \u0440\u0430\u043D\u0456\u0448\u0435."
    - "\u0414\u0435\u044F\u043A\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456
      \u043F\u043E\u0447\u0430\u043B\u0438 \u0441\u043B\u0430\u0431\u0448\u0430\u0442\u0438."
    - "\u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C
      \u0432\u0442\u043E\u043C\u043B\u0435\u043D\u0438\u043C\u0438."
    - "\u042F \u0442\u0440\u043E\u0445\u0438 \u0437\u0430\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044C
      \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u044E."
    - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043C\u0456\u0433
      \u0431\u0443\u0442\u0438 \u043A\u0440\u0430\u0449\u0438\u043C."
    - "\u041D\u0435 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E, \u0430\u043B\u0435
      \u043F\u043E\u043C\u0456\u0442\u043D\u043E."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0431\u0443\u0434\u0443 \u0443\u0432\u0430\u0436\u043D\u0456\u0448\u0438\u043C."
    medium:
    - "\u0406\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u0441\u0432\u043E\u0454\u0457 \u0441\u0438\u043B\u0438."
    - "\u042F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044F
      \u0437 \u043E\u0431\u0440\u043E\u0431\u043A\u043E\u044E \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u0441\u0442\u0430\u043B\u0430
      \u0441\u043B\u0430\u0431\u0448\u043E\u044E, \u043D\u0456\u0436 \u043C\u043E\u0433\u043B\u0430
      \u0431\u0443\u0442\u0438."
    - "\u041F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u0437\u0430\u0442\u044F\u0433\u043D\u0443\u043B\u0430\u0441\u044F
      \u043D\u0430\u0434\u0442\u043E \u0434\u043E\u0432\u0433\u043E."
    - "\u0414\u0435\u044F\u043A\u0456 \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0456
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u043D\u0438\u043A\u043B\u0438."
    - "\u0421\u0445\u043E\u0436\u0435, \u044F \u0437\u0430\u0431\u0440\u0430\u043B\u0430
      \u0443 \u0441\u0443\u043C\u0456\u0448\u0456 \u0447\u0430\u0441\u0442\u0438\u043D\u0443
      \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B\u0443."
    - "\u0426\u0435 \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0443\u0440\u043E\u043A
      \u043D\u0430 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454."
    - "\u0412\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u0440\u0430\u043D\u0456\u0448\u0435."
    - "\u041D\u0435 \u0432\u0441\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454
      \u0442\u0430\u043A\u043E\u0457 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0456."
    - "\u0406\u043D\u043E\u0434\u0456 \u043A\u0440\u0430\u0449\u0435 \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F
      \u0432\u0447\u0430\u0441\u043D\u043E."
    severe:
    - "\u042F \u0437\u0456\u043F\u0441\u0443\u0432\u0430\u043B\u0430 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u0449\u0435 \u0434\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0443."
    - "\u0412\u0456\u0434 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u0445
      \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F."
    - "\u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u0438\u043C\u0438."
    - "\u0421\u0443\u043C\u0456\u0448 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u0454
      \u0432\u0456\u0434 \u0441\u0442\u0430\u0440\u0438\u0445 \u043F\u043E\u043C\u0438\u043B\u043E\u043A."
    - "\u042F \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0437\u0430\u043C\u0443\u0447\u0438\u043B\u0430
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u044E."
    - "\u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430
      \u0431\u0456\u043B\u044C\u0448\u0443 \u0447\u0430\u0441\u0442\u0438\u043D\u0443
      \u0441\u0432\u043E\u0454\u0457 \u0441\u0438\u043B\u0438."
    - "\u0426\u0435 \u043D\u0430\u0433\u0430\u0434\u0443\u0454 \u043D\u0435 \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443,
      \u0430 \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u043D\u044F."
    - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443
      \u0442\u0440\u0435\u0431\u0430 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0448\u0432\u0438\u0434\u0448\u0435, \u0430 \u043D\u0435 \u0434\u043E\u0432\u0448\u0435."
    - "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0430
      \u0445\u043E\u0440\u043E\u0448\u0456 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438
      \u043D\u0430 \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u0456."
    - "\u0421\u0443\u043C\u043D\u043E \u0443\u0441\u0432\u0456\u0434\u043E\u043C\u043B\u044E\u0432\u0430\u0442\u0438,
      \u0449\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u043F\u043E\u0447\u0430\u043B\u0430\u0441\u044F
      \u0437\u0430\u0434\u043E\u0432\u0433\u043E \u0434\u043E \u043A\u043E\u0442\u043B\u0430."
