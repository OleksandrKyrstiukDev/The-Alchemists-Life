  clientName: "\u041C\u0438\u0440\u043E\u043D \u0427\u0435\u0440\u043D\u0435\u0446\u044C"
  portrait: {fileID: -35627331, guid: b165680d616a6f5498452dac0c083dbc, type: 3}
  shortDescription: "\u0411\u0440\u0430\u0442\u0456\u044F \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u0430
    \u043F\u0456\u0441\u043B\u044F \u0434\u043E\u0433\u043B\u044F\u0434\u0443 \u0437\u0430
    \u0445\u0432\u043E\u0440\u0438\u043C\u0438."
  fullDescription: "\u0423 \u043C\u043E\u043D\u0430\u0441\u0442\u0438\u0440\u0456
    \u0437\u043D\u043E\u0432\u0443 \u0431\u0430\u0433\u0430\u0442\u043E \u043D\u0435\u0434\u0443\u0436\u0438\u0445.
    \u0411\u0440\u0430\u0442\u0438 \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C
    \u043C\u0430\u0439\u0436\u0435 \u0431\u0435\u0437 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u043A\u0443.
    \u042F \u043D\u0435 \u043C\u043E\u0436\u0443 \u043F\u0440\u043E\u0441\u0438\u0442\u0438
    \u043F\u0440\u043E \u0430\u043B\u0445\u0456\u043C\u0456\u044E \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E,
    \u0430\u043B\u0435 \u043C\u0443\u0448\u0443 \u043F\u0440\u043E\u0441\u0438\u0442\u0438.
    \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0449\u043E\u0441\u044C, \u0449\u043E
    \u043F\u043E\u0432\u0435\u0440\u043D\u0435 \u0441\u0438\u043B\u0438 \u043B\u044E\u0434\u044F\u043C,
    \u044F\u043A\u0456 \u0432\u0436\u0435 \u043A\u0456\u043B\u044C\u043A\u0430 \u0434\u043D\u0456\u0432
    \u043D\u0435 \u0441\u043F\u043B\u044F\u0442\u044C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E."
  requiredPurpose: 10
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0437\u0430\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0456
    \u0442\u0430 \u043F\u043E\u0431\u0456\u0447\u043D\u0438\u0445 \u0435\u0444\u0435\u043A\u0442\u0456\u0432."
