  clientName: "\u0413\u043D\u0430\u0442 \u0412\u0430\u0440\u0442\u043E\u0432\u0438\u0439"
  portrait: {fileID: -272420758, guid: d3b8ac0556a1f124ca54ed3b09fb1ec5, type: 3}
  shortDescription: "\u0421\u043F\u0438\u0441 \u0432\u0430\u0436\u0447\u0438\u0439
    \u0437\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u0438\u0439 \u0433\u043B\u0443\u0437\u0434
    \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430."
  fullDescription: "\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440 \u0432\u0438\u0440\u0456\u0448\u0438\u0432,
    \u0449\u043E \u0442\u0435\u043F\u0435\u0440 \u0432\u0430\u0440\u0442\u0430 \u043C\u0430\u0454
    \u0445\u043E\u0434\u0438\u0442\u0438 \u0432 \u043F\u043E\u0432\u043D\u043E\u043C\u0443
    \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u0456 \u043D\u0430\u0432\u0456\u0442\u044C
    \u043F\u0456\u0434 \u0447\u0430\u0441 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E
    \u043F\u0430\u0442\u0440\u0443\u043B\u044E\u0432\u0430\u043D\u043D\u044F. \u041F\u0456\u0441\u043B\u044F
    \u0437\u043C\u0456\u043D\u0438 \u0440\u0443\u043A\u0438 \u0442\u0440\u044F\u0441\u0443\u0442\u044C\u0441\u044F
    \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u044F \u0441\u0430\u043C \u0441\u0435\u0431\u0435
    \u0437\u0430\u0430\u0440\u0435\u0448\u0442\u043E\u0432\u0443\u044E. \u0422\u0440\u0435\u0431\u0430
    \u0449\u043E\u0441\u044C \u043D\u0430 \u0444\u0456\u0437\u0438\u0447\u043D\u0443
    \u043A\u0440\u0456\u043F\u043A\u0456\u0441\u0442\u044C."
  requiredPurpose: 13
  minimumQuality: 2
  restrictions: "\u0411\u0435\u0437 \u0433\u0430\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0456\u0439
