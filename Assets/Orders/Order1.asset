  m_Name: Order1
  m_EditorClassIdentifier: Assembly-CSharp::OrderObject
  clientName: "\u041B\u044E\u0431\u043E\u043C\u0438\u0440"
  portrait: {fileID: -947758557, guid: 2bd764e1e7976404d85ecebd0185a4c0, type: 3}
  shortDescription: "\u0414\u0440\u043E\u0432\u0430 \u0437\u043C\u043E\u043A\u043B\u0438,
    \u0436\u0456\u043D\u043A\u0430 \u043F\u0438\u043B\u0438\u0442\u044C, \u0440\u044F\u0442\u0443\u0439!"
  fullDescription: "\u0422\u0430 \u044F\u043A\u0430\u0441\u044C \u0430\u043D\u043E\u043C\u0430\u043B\u0456\u044F,
    \u0430 \u043D\u0435 \u043F\u043E\u0433\u043E\u0434\u0430! \u041F\u0456\u0448\u043E\u0432
    \u0443 \u0441\u0430\u0440\u0430\u0439, \u0430 \u0442\u0430\u043C \u0434\u0430\u0445
    \u043F\u0440\u043E\u0442\u0456\u043A \u043F\u0440\u044F\u043C\u043E \u043D\u0430
    \u0434\u0443\u0431\u043E\u0432\u0456 \u0446\u0443\u0440\u043A\u0438. \u0422\u0435\u043F\u0435\u0440
    \u0432\u043E\u043D\u0438 \u043D\u0435 \u0433\u043E\u0440\u044F\u0442\u044C, \u0430
    \u0442\u0456\u043B\u044C\u043A\u0438 \u0441\u043C\u0435\u0440\u0434\u044F\u0442\u044C
    \u0456 \u0434\u0438\u043C\u043B\u044F\u0442\u044C \u043D\u0430 \u0432\u0441\u044E
    \u0445\u0430\u0442\u0443. \u0416\u0456\u043D\u043A\u0430 \u0432\u0436\u0435 \u0442\u0430\u043A
    \u0440\u043E\u0437\u043F\u0438\u043B\u0456\u043B\u0430\u0441\u044C, \u0449\u043E
    \u043C\u0435\u043D\u0456 \u0442\u0435 \u0437\u0456\u043B\u043B\u044F \u0442\u0440\u0435\u0431\u0430
    \u0456 \u0434\u0440\u043E\u0432\u0430 \u043F\u043E\u0441\u0443\u0448\u0438\u0442\u044C,
    \u0456 \u0457\u0457 \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u044C.
    \u0414\u0430\u0439 \xAB\u0422\u0435\u043F\u043B\u043E\u0433\u043E \u0448\u0435\u043F\u043E\u0442\u0443\xBB,
    \u0449\u043E\u0431 \u0432\u043E\u043D\u043E \u0434\u0435\u043B\u0456\u043A\u0430\u0442\u043D\u043E
    \u0442\u0430\u043A, \u0431\u0435\u0437 \u0432\u0438\u0431\u0443\u0445\u0456\u0432,
    \u0442\u0443 \u0432\u043E\u043B\u043E\u0433\u0443 \u0432\u0438\u0433\u043D\u0430\u043B\u043E."
  requiredPurpose: 0
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0432\u0438\u0431\u0443\u0445\u0456\u0432"
