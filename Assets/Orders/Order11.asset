  clientName: "\u041C\u0430\u0440\u0442\u0430 \u041F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u044F"
  portrait: {fileID: -553242814, guid: b15c8a1cbf867b844a1d46c2e98c0073, type: 3}
  shortDescription: "\u0423 \u043A\u043E\u043C\u043E\u0440\u0456 \u0437\u0430\u0432\u0435\u043B\u043E\u0441\u044F
    \u0449\u043E\u0441\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0436\u0438\u0432\u0435."
  fullDescription: "\u0429\u0443\u0440\u0438 \u0432\u043A\u0440\u0430\u043B\u0438
    \u0431\u0456\u043B\u044C\u0448\u0435 \u0457\u0436\u0456, \u043D\u0456\u0436 \u0434\u0435\u044F\u043A\u0456
    \u043C\u043E\u0457 \u043A\u043B\u0456\u0454\u043D\u0442\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
    \u0441\u043E\u0431\u0456 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438
    \u043A\u0443\u043F\u0438\u0442\u0438. \u041F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
    \u0437\u0430\u0441\u0456\u0431, \u0449\u043E\u0431 \u0432\u0456\u0434\u043B\u044F\u043A\u0430\u0442\u0438
    \u0446\u044E \u0445\u0432\u043E\u0441\u0442\u0430\u0442\u0443 \u043C\u0430\u0444\u0456\u044E
    \u0431\u0435\u0437 \u043E\u0442\u0440\u0443\u0454\u043D\u043D\u044F \u0437\u0430\u043F\u0430\u0441\u0456\u0432."
  requiredPurpose: 2
  minimumQuality: 0
  restrictions: "\u041D\u0435 \u0448\u043A\u043E\u0434\u0438\u0442\u0438 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430\u043C."
