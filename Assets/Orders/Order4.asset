  m_Name: Order4
  m_EditorClassIdentifier: Assembly-CSharp::OrderObject
  clientName: "\u041C\u0430\u0440\u0442\u0430 \u041F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u044F"
  portrait: {fileID: -553242814, guid: b15c8a1cbf867b844a1d46c2e98c0073, type: 3}
  shortDescription: "\u0423 \u043C\u0435\u043D\u0435 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044C\u0446\u0456
    \u0432\u0436\u0435 \u043F\u0430\u0440\u043E\u044E \u0437 \u0440\u043E\u0442\u0430
    \u0434\u0438\u043C\u043B\u044F\u0442\u044C. \u0422\u0440\u0435\u0431\u0430 \u0442\u0435\u043F\u043B\u043E,
    \u0430 \u043D\u0435 \u0449\u0435 \u043E\u0434\u0438\u043D \u043F\u043E\u0445\u043E\u0440\u043E\u043D."
  fullDescription: "\u041A\u0430\u043C\u0456\u043D \u043D\u0456\u0431\u0438 \u0433\u043E\u0440\u0438\u0442\u044C,
    \u0430 \u0442\u0435\u043F\u043B\u0430 \u0432\u0456\u0434 \u043D\u044C\u043E\u0433\u043E
    \u044F\u043A \u0432\u0456\u0434 \u043E\u0431\u0440\u0430\u0437\u043B\u0438\u0432\u043E\u0433\u043E
    \u043F\u043E\u0433\u043B\u044F\u0434\u0443. \u041B\u044E\u0434\u0438 \u0441\u0438\u0434\u044F\u0442\u044C
    \u0443 \u043F\u043B\u0430\u0449\u0430\u0445, \u0441\u0443\u043F \u0445\u043E\u043B\u043E\u043D\u0435
    \u0448\u0432\u0438\u0434\u0448\u0435, \u043D\u0456\u0436 \u044F \u0432\u0441\u0442\u0438\u0433\u0430\u044E
    \u0439\u043E\u0433\u043E \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0438. \u041E\u0434\u0438\u043D
    \u043C\u0438\u0441\u043B\u0438\u0432\u0435\u0446\u044C \u0443\u0437\u0430\u0433\u0430\u043B\u0456
    \u0441\u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0432 \u043A\u0456\u043C\u043D\u0430\u0442\u0456
    \u201C\u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u043C\u043E\u0433\u0438\u043B\u0438\u201D.
    \u0414\u0443\u0436\u0435 \u0441\u043C\u0456\u0448\u043D\u043E, \u043B\u0435\u0434\u044C
    \u043D\u0435 \u0432\u0434\u0430\u0440\u0438\u043B\u0430 \u043E\u043F\u043E\u043B\u043E\u043D\u0438\u043A\u043E\u043C.\n\u0417\u0432\u0430\u0440\u0438
    \u043C\u0435\u043D\u0456 \u201C\u0422\u0435\u043F\u043B\u0438\u0439 \u0448\u0435\u043F\u0456\u0442\u201D,
    \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0439,
    \u0431\u0435\u0437 \u0446\u0438\u0445 \u0442\u0432\u043E\u0457\u0445 \u0430\u043B\u0445\u0456\u043C\u0456\u0447\u043D\u0438\u0445
    \u0444\u043E\u043A\u0443\u0441\u0456\u0432, \u043F\u0456\u0441\u043B\u044F \u044F\u043A\u0438\u0445
    \u0443 \u0441\u0442\u0435\u043B\u0456 \u043D\u043E\u0432\u0438\u0439 \u043E\u0442\u0432\u0456\u0440
    \u0437\u2019\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F. \u041C\u0435\u043D\u0456
    \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435 \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u0435
    \u0442\u0435\u043F\u043B\u043E, \u0430 \u043D\u0435 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0456\u044F
    \u0442\u043E\u0433\u043E, \u0447\u043E\u043C\u0443 \u0442\u0435\u0431\u0435 \u043B\u044E\u0434\u0438
    \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u044E \u043E\u0431\u0445\u043E\u0434\u044F\u0442\u044C."
  requiredPurpose: 0
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0447\u043E\u0440\u043D\u043E\u0433\u043E \u0434\u0438\u043C\u0443
    \u0439 \u0432\u0438\u0431\u0443\u0445\u0456\u0432. \u041C\u0438\u043D\u0443\u043B\u043E\u0433\u043E
    \u0440\u0430\u0437\u0443 \u043A\u0456\u0442 \u0442\u0440\u0438 \u0434\u043D\u0456
    \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u0432 \u0443 \u043A\u0443\u0445\u043D\u044E."
  goldReward: 15
  reputationReward: 3
  declinePenalty: 1
