  shortDescription: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u044F\u0441\u043D\u0430
    \u0433\u043E\u043B\u043E\u0432\u0430 \u0434\u043B\u044F \u043D\u0456\u0447\u043D\u043E\u0433\u043E
    \u0447\u0435\u0440\u0433\u0443\u0432\u0430\u043D\u043D\u044F."
  fullDescription: "\u0423 \u043C\u0456\u0441\u0442\u0456 \u043F\u0456\u0448\u043B\u0438
    \u0447\u0443\u0442\u043A\u0438 \u043F\u0440\u043E \u0431\u0430\u043D\u0434\u0443
    \u0433\u0440\u0430\u0431\u0456\u0436\u043D\u0438\u043A\u0456\u0432. \u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
    \u0441\u0442\u043E\u0440\u043E\u0436\u0456\u0432 \u0443\u0436\u0435 \u0431\u0430\u0447\u0438\u0442\u044C
    \u0437\u043B\u043E\u0447\u0438\u043D\u0446\u0456\u0432 \u0443 \u043A\u043E\u0436\u043D\u043E\u043C\u0443
    \u043A\u0443\u0449\u0456. \u041C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430
    \u0449\u043E\u0441\u044C, \u0449\u043E\u0431 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u0438\u0441\u044F
    \u0437\u0456\u0431\u0440\u0430\u043D\u0438\u043C \u0456 \u043D\u0435 \u043A\u0438\u0434\u0430\u0442\u0438\u0441\u044F
    \u0441\u043F\u0438\u0441\u043E\u043C \u0443 \u043A\u043E\u0442\u0456\u0432."
  requiredPurpose: 10
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0441\u0438\u043B\u044C\u043D\u0438\u0445 \u0435\u043C\u043E\u0446\u0456\u0439\u043D\u0438\u0445
    \u0435\u0444\u0435\u043A\u0442\u0456\u0432."
