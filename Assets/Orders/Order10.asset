  clientName: "\u041C\u0430\u0440\u0442\u0430 \u041F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u044F"
  portrait: {fileID: -553242814, guid: b15c8a1cbf867b844a1d46c2e98c0073, type: 3}
  shortDescription: "\u0413\u043E\u0441\u0442\u0456 \u043C\u0435\u0440\u0437\u043D\u0443\u0442\u044C
    \u0448\u0432\u0438\u0434\u0448\u0435, \u043D\u0456\u0436 \u043F\u043B\u0430\u0442\u044F\u0442\u044C."
  fullDescription: "\u0423\u0441\u0456 \u0441\u043A\u0430\u0440\u0436\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0445\u043E\u043B\u043E\u0434 \u0443 \u0437\u0430\u043B\u0456.
    \u041E\u0434\u0438\u043D \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A
    \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u044F\u0432\u0438\u0432, \u0449\u043E
    \u043D\u0430\u0434\u0432\u043E\u0440\u0456 \u0442\u0435\u043F\u043B\u0456\u0448\u0435,
    \u043D\u0456\u0436 \u0443 \u043C\u0435\u043D\u0435 \u0431\u0456\u043B\u044F \u043A\u0430\u043C\u0456\u043D\u0430.
    \u0414\u0443\u0436\u0435 \u0441\u043C\u0456\u0448\u043D\u043E. \u0417\u0432\u0430\u0440\u0438
    \u043C\u0435\u043D\u0456 \u0449\u043E\u0441\u044C \u0434\u043B\u044F \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u0433\u043E
    \u0442\u0435\u043F\u043B\u0430, \u043F\u043E\u043A\u0438 \u044F \u043D\u0435
    \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u043B\u0430 \u0446\u0435 \u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F
    \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E."
