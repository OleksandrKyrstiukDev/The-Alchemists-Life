  m_Name: Order3
  m_EditorClassIdentifier: Assembly-CSharp::OrderObject
  clientName: "\u041A\u043B\u0438\u043C \u0429\u0443\u0440\u043E\u043B\u043E\u0432"
  portrait: {fileID: 1806166937, guid: 0cd7c9600f617a64a8276c6e27850143, type: 3}
  shortDescription: "\u0429\u0443\u0440\u0438 \u043E\u0433\u043E\u043B\u043E\u0441\u0438\u043B\u0438
    \u043C\u0435\u043D\u0456 \u0432\u0456\u0439\u043D\u0443, \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
    \u0443\u043B\u044C\u0442\u0438\u043C\u0430\u0442\u0443\u043C."
  fullDescription: "\u0426\u0456 \u0442\u0432\u0430\u0440\u044E\u043A\u0438 \u0432
    \u043F\u0456\u0434\u0437\u0435\u043C\u0435\u043B\u043B\u044F\u0445 \u0437\u043E\u0432\u0441\u0456\u043C
    \u0437\u0434\u0438\u0447\u0430\u0432\u0456\u043B\u0438! \u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0456
    \u043F\u0430\u0441\u0442\u043A\u0438 \u0432\u043E\u043D\u0438 \u0432\u0436\u0435
    \u043E\u0431\u0445\u043E\u0434\u044F\u0442\u044C, \u0442\u043E\u043C\u0443 \u043C\u0435\u043D\u0456
    \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u043F\u0440\u044F\u043C\u043E\u043B\u0456\u043D\u0456\u0439\u043D\u0430
    \u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0430 \u043E\u0442\u0440\u0443\u0442\u0430.
    \u041F\u0440\u0438\u0433\u043E\u0442\u0443\u0439 \u0437\u0456\u043B\u043B\u044F
    \xAB\u0427\u043E\u0440\u043D\u0438\u0439 \u043A\u043E\u0432\u0442\u043E\u043A\xBB,
    \u0449\u043E\u0431 \u0431\u0443\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u0430
    \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u0430 \u0434\u0456\u044F. \u0422\u0456\u043B\u044C\u043A\u0438
    \u0437\u0440\u043E\u0431\u0438 \u044F\u043A\u0456\u0441\u043D\u043E, \u0431\u043E
    \u044F\u043A\u0449\u043E \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u043E\u0442\u0440\u0443\u0442\u0438
    \u0432\u0438\u0439\u0434\u0435 \u043F\u0440\u043E\u0432\u0430\u043B \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456
    \u0432\u0438\u0431\u0443\u0445\u0443 \u0437 \u0447\u043E\u0440\u043D\u0438\u043C
    \u0434\u0438\u043C\u043E\u043C, \u043C\u0435\u043D\u0435 \u0441\u0430\u043C\u043E\u0433\u043E
    \u0432\u0438\u043A\u0443\u0440\u044F\u0442\u044C \u0437 \u043C\u043E\u0433\u043E
    \u0436 \u043A\u043E\u043B\u0435\u043A\u0442\u043E\u0440\u0430."
