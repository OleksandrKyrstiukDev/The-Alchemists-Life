  clientName: "\u0420\u0443\u0442\u0430 \u041C\u043E\u0433\u0438\u043B\u044C\u043D\u0438\u0446\u044F"
  portrait: {fileID: 1807413954, guid: eb4b8b7d38b08d84eb284814102584fc, type: 3}
  shortDescription: "\u0417\u043D\u043E\u0432\u0443 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
    \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438 \u0434\u043E \u0441\u0432\u0456\u0442\u0430\u043D\u043A\u0443."
  fullDescription: "\u041D\u0430 \u043A\u043B\u0430\u0434\u043E\u0432\u0438\u0449\u0456
    \u0434\u043E\u0434\u0430\u043B\u043E\u0441\u044F \u0440\u043E\u0431\u043E\u0442\u0438,
    \u0430 \u0441\u0438\u043B\u0438 \u0432\u0436\u0435 \u043D\u0435 \u0442\u0456.
    \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0449\u043E\u0441\u044C, \u0449\u043E
    \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F
    \u043D\u0430 \u043D\u043E\u0433\u0430\u0445 \u0449\u0435 \u043A\u0456\u043B\u044C\u043A\u0430
    \u043D\u043E\u0447\u0435\u0439. \u041B\u044E\u0434\u0438 \u0434\u0443\u043C\u0430\u044E\u0442\u044C,
    \u0449\u043E \u043C\u0435\u0440\u0442\u0432\u0456 \u043B\u0435\u0436\u0430\u0442\u044C
    \u0443 \u0437\u0435\u043C\u043B\u0456 \u0441\u0430\u043C\u0456 \u0441\u043E\u0431\u043E\u044E.
    \u0411\u0443\u043B\u043E \u0431 \u0447\u0443\u0434\u043E\u0432\u043E."
  requiredPurpose: 11
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0440\u0456\u0437\u043A\u043E\u0433\u043E \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u043D\u044F
    \u043F\u0456\u0441\u043B\u044F \u0434\u0456\u0457."
  goldReward: 16
  reputationReward: 4
  declinePenalty: 2
  requiredTier: 3
