  clientName: "\u0417\u043E\u0440\u044F\u043D \u0427\u043E\u0440\u043D\u043E\u0440\u0443\u043A"
  portrait: {fileID: 1494990678, guid: 0e0b3d57572ea6d46bbdc7a56fb782e7, type: 3}
  shortDescription: "\u0417\u043C\u0456\u043D\u0430 \u0432 \u0448\u0430\u0445\u0442\u0456
    \u0442\u0440\u0438\u0432\u0430\u0454 \u0434\u043E\u0431\u0443, \u0441\u0438\u043B\u0438
    \u0437\u0430\u043A\u0456\u043D\u0447\u0443\u044E\u0442\u044C\u0441\u044F."
  fullDescription: "\u041F\u0456\u0441\u043B\u044F \u043E\u0431\u0432\u0430\u043B\u0443
    \u043C\u0435\u043D\u0456 \u0434\u0430\u044E\u0442\u044C \u043D\u0430\u0439\u0432\u0430\u0436\u0447\u0443
    \u0440\u043E\u0431\u043E\u0442\u0443, \u0456 \u044F \u0432\u0436\u0435 \u043B\u0435\u0434\u044C
    \u0442\u0440\u0438\u043C\u0430\u044E \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438.
    \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u0456\u043B\u043B\u044F,
    \u044F\u043A\u0435 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454 \u0435\u043D\u0435\u0440\u0433\u0456\u044E
    \u0431\u0435\u0437 \u0440\u0456\u0437\u043A\u0438\u0445 \u0435\u0444\u0435\u043A\u0442\u0456\u0432.
    \u0417\u0432\u0430\u0440\u0438 \u043C\u0435\u043D\u0456 \xAB\u0417\u0431\u0456\u0440
    \u0441\u0438\u043B\xBB. \u041C\u0435\u043D\u0456 \u043A\u043E\u043D\u0447\u0435
    \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435 \u0446\u0435 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
    \u0441\u0438\u043B, \u0431\u043E \u043F\u0456\u0441\u043B\u044F \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u044F
    \u0434\u0456\u0457 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E
    \u0447\u0430\u044E \u043D\u0430\u0441\u0442\u0430\u0454 \u0434\u0438\u043A\u0430
    \u0432\u0442\u043E\u043C\u0430."
