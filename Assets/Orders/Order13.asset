  clientName: "\u0420\u0443\u0442\u0430 \u041C\u043E\u0433\u0438\u043B\u044C\u043D\u0438\u0446\u044F"
  portrait: {fileID: 1807413954, guid: eb4b8b7d38b08d84eb284814102584fc, type: 3}
  shortDescription: "\u0421\u0432\u0456\u0436\u0456 \u043C\u043E\u0433\u0438\u043B\u0438
    \u043F\u043E\u0447\u0430\u043B\u0438 \u043E\u0441\u0456\u0434\u0430\u0442\u0438
    \u043F\u0456\u0441\u043B\u044F \u0434\u043E\u0449\u0456\u0432."
  fullDescription: "\u041F\u0456\u0441\u043B\u044F \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457
    \u0437\u043B\u0438\u0432\u0438 \u0437\u0435\u043C\u043B\u044F \u0441\u0442\u0430\u043B\u0430
    \u043D\u0430\u0434\u0442\u043E \u043C'\u044F\u043A\u043E\u044E. \u0414\u043E\u0440\u0456\u0436\u043A\u0438
    \u043F\u0440\u043E\u0432\u0430\u043B\u044E\u044E\u0442\u044C\u0441\u044F, \u043E\u0433\u043E\u0440\u043E\u0436\u0456
    \u0445\u0438\u043B\u044F\u0442\u044C\u0441\u044F, \u0430 \u0440\u043E\u0434\u0438\u0447\u0456
    \u043F\u043E\u043C\u0435\u0440\u043B\u0438\u0445 \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C
    \u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043D\u0435\u0437\u0440\u0443\u0447\u043D\u0456
    \u043F\u0438\u0442\u0430\u043D\u043D\u044F. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
    \u0441\u0443\u043C\u0456\u0448 \u0434\u043B\u044F \u0437\u043C\u0456\u0446\u043D\u0435\u043D\u043D\u044F
    \u0491\u0440\u0443\u043D\u0442\u0443 \u0442\u0430 \u0434\u0440\u0456\u0431\u043D\u043E\u0433\u043E
    \u0440\u0435\u043C\u043E\u043D\u0442\u0443."
  requiredPurpose: 5
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u0438\u0445
    \u0432\u0438\u043F\u0430\u0440\u0456\u0432."
