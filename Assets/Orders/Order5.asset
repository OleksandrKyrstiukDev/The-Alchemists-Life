  clientName: "\u0413\u043D\u0430\u0442 \u0412\u0430\u0440\u0442\u043E\u0432\u0438\u0439"
  portrait: {fileID: -272420758, guid: d3b8ac0556a1f124ca54ed3b09fb1ec5, type: 3}
  shortDescription: "\u041D\u0456\u0447\u043D\u0430 \u0432\u0430\u0440\u0442\u0430
    \u0432\u0436\u0435 \u043D\u0435 \u0442\u0430, \u043D\u043E\u0433\u0438 \u0437\u0434\u0430\u044E\u0442\u044C\u0441\u044F
    \u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u0430 \u0437\u043B\u043E\u0447\u0438\u043D\u0446\u0456\u0432."
  fullDescription: "\u0422\u0440\u0435\u0442\u044E \u043D\u0456\u0447 \u043F\u043E\u0441\u043F\u0456\u043B\u044C
    \u0433\u0430\u043D\u044F\u044E\u0441\u044F \u0437\u0430 \u044F\u043A\u0438\u043C\u043E\u0441\u044C
    \u0434\u0440\u0456\u0431\u043D\u0438\u043C \u0437\u043B\u043E\u0434\u044E\u0436\u043A\u043E\u044E.
    \u0412\u0456\u043D \u043C\u043E\u043B\u043E\u0434\u0438\u0439, \u0448\u0432\u0438\u0434\u043A\u0438\u0439
    \u0456 \u043C\u0430\u0454 \u043F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u043E
    \u0431\u0430\u0433\u0430\u0442\u043E \u0432\u0456\u043B\u044C\u043D\u043E\u0433\u043E
    \u0447\u0430\u0441\u0443. \u0410 \u044F \u0432\u0436\u0435 \u043D\u0435 \u0445\u043B\u043E\u043F\u0435\u0446\u044C.
    \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0449\u043E\u0441\u044C \u0434\u043B\u044F
    \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u0442\u0456, \u0449\u043E\u0431
    \u043D\u0435 \u0437\u0430\u0441\u043D\u0443\u0442\u0438 \u043D\u0430 \u043F\u043E\u0441\u0442\u0443
    \u0439 \u043D\u0435 \u0437\u0433\u0430\u043D\u044C\u0431\u0438\u0442\u0438\u0441\u044F
    \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u043E\u043C."
  requiredPurpose: 11
  minimumQuality: 1
  restrictions: "\u0411\u0435\u0437 \u0441\u043E\u043D\u043B\u0438\u0432\u043E\u0441\u0442\u0456
    \u043F\u0456\u0441\u043B\u044F \u0434\u0456\u0457."
